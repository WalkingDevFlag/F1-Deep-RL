const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');

let trackImg = new Image();
let carImg = new Image();
let offscreenCanvas = document.createElement('canvas');
let offscreenCtx = offscreenCanvas.getContext('2d', { willReadFrequently: true });
let scaleX, scaleY;

// Car properties
const carWidth = 32;
const carHeight = 16;
let car = { 
    x: 400, 
    y: 300, 
    angle: 0, 
    speed: 0,
    acceleration: 0.5,
    maxSpeed: 8,
    friction: 0.95,
    damaged: false,
    polygon: [],
    sensor: null
};

// Sensor properties
const rayCount = 5;
const rayLength = 150;
const raySpread = Math.PI / 2;

class Sensor {
    constructor(car) {
        this.car = car;
        this.rayCount = rayCount;
        this.rayLength = rayLength;
        this.raySpread = raySpread;
        this.rays = [];
        this.readings = [];
    }

    update() {
        this.castRays();
        this.readings = [];
        for (let i = 0; i < this.rays.length; i++) {
            this.readings.push(this.getRayReading(this.rays[i]));
        }
    }

    getRayReading(ray) {
        const start = ray[0];
        const end = ray[1];
        const dx = end.x - start.x;
        const dy = end.y - start.y;
        const length = Math.hypot(dx, dy);
        const steps = Math.ceil(length);
        
        for (let i = 0; i <= steps; i++) {
            const t = i / steps;
            const px = Math.floor(start.x + dx * t);
            const py = Math.floor(start.y + dy * t);
            
            if (px < 0 || py < 0 || px >= trackImg.width || py >= trackImg.height) {
                return {
                    x: px,
                    y: py,
                    offset: t
                };
            }
            
            const pixel = offscreenCtx.getImageData(px, py, 1, 1).data;
            if (pixel[3] === 0) { // hit track boundary
                return {
                    x: px,
                    y: py,
                    offset: t
                };
            }
        }
        return null;
    }

    castRays() {
        this.rays = [];
        for (let i = 0; i < this.rayCount; i++) {
            const rayAngle = lerp(
                this.raySpread / 2,
                -this.raySpread / 2,
                this.rayCount == 1 ? 0.5 : i / (this.rayCount - 1)
            ) + this.car.angle;

            const start = { x: this.car.x, y: this.car.y };
            const end = {
                x: this.car.x - Math.sin(rayAngle) * this.rayLength,
                y: this.car.y - Math.cos(rayAngle) * this.rayLength
            };
            this.rays.push([start, end]);
        }
    }

    draw(ctx) {
        for (let i = 0; i < this.rayCount; i++) {
            let end = this.rays[i][1];
            if (this.readings[i]) {
                end = this.readings[i];
            }

            ctx.beginPath();
            ctx.lineWidth = 2;
            ctx.strokeStyle = "yellow";
            ctx.moveTo(
                this.rays[i][0].x,
                this.rays[i][0].y
            );
            ctx.lineTo(
                end.x,
                end.y
            );
            ctx.stroke();

            ctx.beginPath();
            ctx.lineWidth = 2;
            ctx.strokeStyle = "black";
            ctx.moveTo(
                this.rays[i][1].x,
                this.rays[i][1].y
            );
            ctx.lineTo(
                end.x,
                end.y
            );
            ctx.stroke();
        }
    }
}

let spawnPoint = { x: 400, y: 300, angle: 0 };

function findSafeSpawnPoint() {
    const imageData = offscreenCtx.getImageData(0, 0, trackImg.width, trackImg.height);
    const centerX = Math.floor(trackImg.width / 2);
    const centerY = Math.floor(trackImg.height / 2);
    
    // Helper to check if entire car fits at position
    function isCarSafe(testX, testY) {
        const buffer = 5; // Extra safety margin
        for (let dx = -carWidth/2 - buffer; dx <= carWidth/2 + buffer; dx += 3) {
            for (let dy = -carHeight/2 - buffer; dy <= carHeight/2 + buffer; dy += 3) {
                const px = Math.floor(testX + dx);
                const py = Math.floor(testY + dy);
                
                // Out of bounds check
                if (px < 0 || px >= trackImg.width || py < 0 || py >= trackImg.height) {
                    return false;
                }
                
                const idx = (py * trackImg.width + px) * 4;
                // Off track (transparent area)
                if (imageData.data[idx + 3] === 0) {
                    return false;
                }
            }
        }
        return true;
    }
    
    // First try center
    if (isCarSafe(centerX, centerY)) {
        console.log('Spawn: Center position is safe');
        return { x: centerX, y: centerY, angle: Math.PI }; // Face downward
    }
    
    // Search in expanding circles
    for (let radius = 100; radius < Math.max(trackImg.width, trackImg.height) / 2; radius += 20) {
        for (let angle = 0; angle < Math.PI * 2; angle += 0.2) {
            const testX = Math.floor(centerX + Math.cos(angle) * radius);
            const testY = Math.floor(centerY + Math.sin(angle) * radius);
            
            if (isCarSafe(testX, testY)) {
                console.log('Spawn: Found safe position at', testX, testY);
                return { x: testX, y: testY, angle: Math.PI }; // Face downward
            }
        }
    }
    
    // Fallback: scan entire track
    console.warn('Spawn: Scanning entire track for safe position...');
    for (let y = 50; y < trackImg.height - 50; y += 30) {
        for (let x = 50; x < trackImg.width - 50; x += 30) {
            if (isCarSafe(x, y)) {
                console.log('Spawn: Found safe position at', x, y, '(fallback scan)');
                return { x, y, angle: Math.PI };
            }
        }
    }
    
    // Last resort
    console.error('Spawn: No safe position found! Using center anyway.');
    return { x: centerX, y: centerY, angle: Math.PI };
}

function resetCar() {
    car.x = spawnPoint.x;
    car.y = spawnPoint.y;
    car.angle = spawnPoint.angle;
    car.speed = 0;
    car.damaged = false;
    car.polygon = createPolygon();
    car.sensor = new Sensor(car);
    console.log('Car reset to spawn point:', spawnPoint);
}

trackImg.onload = () => {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    scaleX = canvas.width / trackImg.width;
    scaleY = canvas.height / trackImg.height;
    offscreenCanvas.width = trackImg.width;
    offscreenCanvas.height = trackImg.height;
    offscreenCtx.drawImage(trackImg, 0, 0);
    
    // Find safe spawn point
    spawnPoint = findSafeSpawnPoint();
    console.log('Found spawn point:', spawnPoint);
    
    // Initialize car at spawn point
    resetCar();
    draw();
};

trackImg.src = '/tracks/Albert_Park_Circuit_Melbourne_Track_Transparent.png';
carImg.src = '/cars/car.png';

trackImg.onerror = () => { console.log('Track image failed to load'); };
carImg.onerror = () => { console.log('Car image failed to load'); };
carImg.onload = () => { console.log('Car image loaded'); };

let keys = {};

document.addEventListener('keydown', (e) => { 
    keys[e.code] = true;
    
    // Reset on R key
    if (e.code === 'KeyR') {
        resetCar();
    }
});
document.addEventListener('keyup', (e) => { keys[e.code] = false; });

// Utility functions
function lerp(a, b, t) {
    return a + (b - a) * t;
}

function getIntersection(A, B, C, D) {
    const tTop = (D.x - C.x) * (A.y - C.y) - (D.y - C.y) * (A.x - C.x);
    const uTop = (C.y - A.y) * (A.x - B.x) - (C.x - A.x) * (A.y - B.y);
    const bottom = (D.y - C.y) * (B.x - A.x) - (D.x - C.x) * (B.y - A.y);
    
    if (bottom != 0) {
        const t = tTop / bottom;
        const u = uTop / bottom;
        if (t >= 0 && t <= 1 && u >= 0 && u <= 1) {
            return {
                x: lerp(A.x, B.x, t),
                y: lerp(A.y, B.y, t),
                offset: t
            };
        }
    }
    return null;
}

function createPolygon() {
    // Create car rectangle corners (like DDQN Car Racing)
    const points = [];
    const halfW = carWidth / 2;
    const halfH = carHeight / 2;
    
    // Base corners (unrotated)
    const corners = [
        { x: -halfW, y: -halfH }, // top-left
        { x: halfW, y: -halfH },  // top-right
        { x: halfW, y: halfH },   // bottom-right
        { x: -halfW, y: halfH }   // bottom-left
    ];
    
    // Rotate each corner around car center
    for (const corner of corners) {
        const rotatedX = car.x + corner.x * Math.cos(car.angle) - corner.y * Math.sin(car.angle);
        const rotatedY = car.y + corner.x * Math.sin(car.angle) + corner.y * Math.cos(car.angle);
        points.push({ x: rotatedX, y: rotatedY });
    }
    
    return points;
}

function assessDamage() {
    for (let i = 0; i < car.polygon.length; i++) {
        const point = car.polygon[i];
        const px = Math.floor(point.x);
        const py = Math.floor(point.y);
        if (px < 0 || py < 0 || px >= trackImg.width || py >= trackImg.height) {
            return true;
        }
        const pixel = offscreenCtx.getImageData(px, py, 1, 1).data;
        if (pixel[3] === 0) { // off track
            return true;
        }
    }
    return false;
}

function update() {
    if (!car.damaged) {
        // Simple controls - just move in direction of angle
        let moveX = 0;
        let moveY = 0;
        
        if (keys['KeyW'] || keys['ArrowUp']) {
            moveX = Math.cos(car.angle) * 3;
            moveY = Math.sin(car.angle) * 3;
        }
        if (keys['KeyS'] || keys['ArrowDown']) {
            moveX = -Math.cos(car.angle) * 2;
            moveY = -Math.sin(car.angle) * 2;
        }
        if (keys['KeyA'] || keys['ArrowLeft']) {
            car.angle -= 0.05;
        }
        if (keys['KeyD'] || keys['ArrowRight']) {
            car.angle += 0.05;
        }

        // Move car
        car.x += moveX;
        car.y += moveY;

        // Clamp to bounds
        car.x = Math.max(carWidth, Math.min(trackImg.width - carWidth, car.x));
        car.y = Math.max(carHeight, Math.min(trackImg.height - carHeight, car.y));

        // Update polygon
        car.polygon = createPolygon();
        
        // Check collision
        const wasDamaged = car.damaged;
        car.damaged = assessDamage();
        
        // Auto-reset on collision after a delay
        if (car.damaged && !wasDamaged) {
            console.log('Collision detected! Press R to reset.');
            setTimeout(() => {
                if (car.damaged) {
                    resetCar();
                }
            }, 1500); // Auto-reset after 1.5 seconds
        }
    }
    
    // Update sensors
    if (car.sensor) {
        car.sensor.update();
    }
}

function drawSensors() {
    if (car.sensor) {
        car.sensor.draw(ctx);
    }
}

function draw() {
    ctx.save();
    ctx.scale(scaleX, scaleY);
    
    // Draw background
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, trackImg.width, trackImg.height);
    
    // Draw track
    ctx.drawImage(trackImg, 0, 0);
    
    // Draw sensors
    drawSensors();
    
    // Draw car polygon (for debugging)
    if (car.polygon.length > 0) {
        ctx.fillStyle = car.damaged ? "gray" : "rgba(0, 255, 0, 0.2)";
        ctx.beginPath();
        ctx.moveTo(car.polygon[0].x, car.polygon[0].y);
        for (let i = 1; i < car.polygon.length; i++) {
            ctx.lineTo(car.polygon[i].x, car.polygon[i].y);
        }
        ctx.closePath();
        ctx.fill();
        ctx.strokeStyle = car.damaged ? "red" : "green";
        ctx.lineWidth = 2;
        ctx.stroke();
    }
    
    // Draw car image
    ctx.save();
    ctx.translate(car.x, car.y);
    ctx.rotate(car.angle);
    ctx.filter = car.damaged ? 'grayscale(100%)' : 'none';
    if (carImg.complete && carImg.naturalWidth > 0) {
        ctx.drawImage(carImg, -(carImg.width / 2) * 0.4, -(carImg.height / 2) * 0.4, carImg.width * 0.4, carImg.height * 0.4);
    } else {
        ctx.fillStyle = car.damaged ? 'gray' : 'red';
        ctx.fillRect(-carWidth / 2, -carHeight / 2, carWidth, carHeight);
    }
    ctx.restore();
    
    ctx.restore();
}

function loop() {
    update();
    draw();
    requestAnimationFrame(loop);
}

loop();
